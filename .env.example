PYTHONPATH=~/dev/ai/ragify/ragify-rag

# Server Configuration (gRPC server)
RAGIFY_GRPC_HOST=0.0.0.0
RAGIFY_GRPC_PORT=50051
RAGIFY_GRPC_ENDPOINT=localhost:50051

# VectorDB Config
VECTORDB_URL=http://localhost:6333/
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Embeddings
EMBED_BACKEND=transformers
EMBED_MODEL_HF=BAAI/bge-small-en-v1.5
# Parallelism/batching for the CPU-bound ingest path. Sections are chunked and
# batches embedded concurrently; torch's intra-op threads are pinned to 1 when
# INGEST_WORKERS > 1 so the pool, not torch, provides the parallelism.
INGEST_WORKERS=4
EMBED_BATCH_SIZE=64

# Classification
CLASSIFICATION_URL=
CLASSIFICATION_MODEL=
CLASSIFICATION_API_KEY=

# LLM
LLM_URL=
LLM_MODEL=
LLM_API_KEY=

# Web Search
TAVILY_API_KEY=
